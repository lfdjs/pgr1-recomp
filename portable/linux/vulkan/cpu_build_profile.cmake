# EN: Host is 64-bit; CPU tuning does not change the Xbox guest ABI.
# PT-BR: Host de 64 bits; ajuste de CPU preserva a ABI do Xbox.
if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8 OR NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$")
  message(FATAL_ERROR "Native PGR1 game requires x86-64 host / O jogo exige host x86-64")
endif()
set(PGR1_VK_CPU_PROFILE "auto" CACHE STRING "auto, generic, v2, v3, v4, native")
set_property(CACHE PGR1_VK_CPU_PROFILE PROPERTY STRINGS auto generic v2 v3 v4 native)
set(PGR1_VK_GUEST_OPT "1" CACHE STRING "Generated guest optimization: 1, 2, 3")
set_property(CACHE PGR1_VK_GUEST_OPT PROPERTY STRINGS 1 2 3)
set(PGR1_VK_CPU_SIGNATURE "" CACHE STRING "Local CPU fingerprint from portable-vulkan.sh")
if(NOT PGR1_VK_GUEST_OPT MATCHES "^[123]$")
  message(FATAL_ERROR "PGR1_VK_GUEST_OPT must be 1, 2 or 3")
endif()
set(PGR1_CPU_LOCAL OFF)
if(PGR1_VK_CPU_PROFILE STREQUAL "auto")
  # EN: Native tuning without requiring AVX2; keep x86-64-v2 compatibility.
  # PT-BR: Ajuste local sem exigir AVX2; mantenha compatibilidade x86-64-v2.
  set(PGR1_CPU_FLAGS -march=x86-64-v2 -mtune=generic)
  if(NOT CMAKE_CROSSCOMPILING)
    set(PGR1_CPU_FLAGS -march=x86-64-v2 -mtune=native)
    set(PGR1_CPU_LOCAL ON)
  endif()
elseif(PGR1_VK_CPU_PROFILE MATCHES "^(generic|v2)$")
  set(PGR1_CPU_FLAGS -march=x86-64-v2 -mtune=generic)
elseif(PGR1_VK_CPU_PROFILE MATCHES "^v[34]$")
  set(PGR1_CPU_FLAGS "-march=x86-64-${PGR1_VK_CPU_PROFILE}" -mtune=generic)
elseif(PGR1_VK_CPU_PROFILE STREQUAL "native")
  if(CMAKE_CROSSCOMPILING)
    message(FATAL_ERROR "native CPU profile cannot cross-compile")
  endif()
  if(PGR1_VK_CPU_SIGNATURE STREQUAL "")
    message(FATAL_ERROR "Use scripts/portable-vulkan.sh build-game for native CPU builds")
  endif()
  set(PGR1_CPU_FLAGS -march=native -mtune=native)
  set(PGR1_CPU_LOCAL ON)
else()
  message(FATAL_ERROR "Invalid PGR1_VK_CPU_PROFILE: ${PGR1_VK_CPU_PROFILE}")
endif()
# EN: Fail clearly for unsupported compiler targets.
# PT-BR: Falhe explicitamente se o compilador não reconhecer a arquitetura.
include(CheckCXXCompilerFlag)
foreach(flag IN LISTS PGR1_CPU_FLAGS)
  string(MAKE_C_IDENTIFIER "PGR1_COMPILER_${flag}" flag_check)
  check_cxx_compiler_flag("${flag}" "${flag_check}")
  if(NOT ${flag_check})
    message(FATAL_ERROR "Unsupported CPU flag: ${flag}")
  endif()
endforeach()
message(STATUS "PGR1 CPU / CPU PGR1: ${PGR1_VK_CPU_PROFILE} (${PGR1_CPU_FLAGS}); guest -O${PGR1_VK_GUEST_OPT}")
