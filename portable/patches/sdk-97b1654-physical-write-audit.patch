diff --git a/runtime/kernel/physical_write_audit.h b/runtime/kernel/physical_write_audit.h
new file mode 100644
--- /dev/null
+++ b/runtime/kernel/physical_write_audit.h
@@ -0,0 +1,58 @@
+#pragma once
+#include "memory.h"
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <limits>
+
+namespace mem {
+// EN: Diagnostic attribution only; not a synchronization or coherency proof.
+// PT-BR: Atribuição diagnóstica; não é prova de sincronização ou coerência.
+enum class PhysicalWriteSource : uint8_t {
+    None=0, Scalar=1, Stack=2, Atomic=3, FloatingPoint=4, String=5,
+    KernelHelper=6, FileIO=7, RTL=8
+};
+class PhysicalWriteAudit {
+    static constexpr uint64_t kMaxSequence=UINT64_MAX >> 8;
+    inline static std::atomic<bool> enabled_{false};
+    inline static std::array<std::atomic<uint64_t>,kMappedPhysical/kPage> pages_{};
+    static void Mark(uint32_t address,uint64_t bytes,uint32_t base,PhysicalWriteSource source) {
+        const uint64_t begin=address>base?address:base;
+        const uint64_t end=uint64_t(address)+bytes;
+        const uint64_t limit=uint64_t(base)+kMappedPhysical;
+        const uint64_t clipped=end<limit?end:limit;
+        if(begin>=clipped)return;
+        for(auto p=(begin-base)/kPage;p<=(clipped-1-base)/kPage;++p) {
+            auto& slot=pages_[p];
+            auto old=slot.load(std::memory_order_relaxed);
+            uint64_t next;
+            do {
+                auto seq=old>>8;
+                if(seq<kMaxSequence)++seq;
+                next=(seq<<8)|uint8_t(source);
+            } while(!slot.compare_exchange_weak(old,next,std::memory_order_relaxed));
+        }
+    }
+public:
+    struct Event { uint64_t sequence; PhysicalWriteSource source; };
+    static void Enable(bool enabled) { enabled_.store(enabled,std::memory_order_relaxed); }
+    static void Record(uint32_t address,uint64_t bytes,PhysicalWriteSource source) {
+        // EN: Reject unrelated virtual addresses on the cheap path.
+        // PT-BR: Rejeite VAs alheios no caminho barato.
+        if(!bytes || !enabled_.load(std::memory_order_relaxed))return;
+        const uint64_t remaining=(uint64_t(1)<<32)-address;
+        if(bytes>remaining)bytes=remaining;
+        Mark(address,bytes,kContiguousBase,source);
+        Mark(address,bytes,kWriteCombineBase,source);
+    }
+    static Event Read(uint32_t address) {
+        for(auto base:{kContiguousBase,kWriteCombineBase}) {
+            if(address>=base && uint64_t(address)-base<kMappedPhysical) {
+                auto v=pages_[(address-base)/kPage].load(std::memory_order_relaxed);
+                return {v>>8,PhysicalWriteSource(v&255u)};
+            }
+        }
+        return {0,PhysicalWriteSource::None};
+    }
+};
+} // namespace mem
