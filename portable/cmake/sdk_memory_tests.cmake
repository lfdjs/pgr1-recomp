# EN: Exercise actual SDK helpers and generated instructions without game assets.
# PT-BR: Exercite helpers e instruções geradas reais sem assets do jogo.
if(BUILD_TESTING AND EXISTS "${PGR1_SDK_SOURCE_DIR}/runtime/cpu/x86_ops.h")
  add_executable(pgr1_sdk_rep_runtime_test "${PGR1_ROOT}/portable/tests/memory/test_sdk_rep_runtime.cpp")
  target_include_directories(pgr1_sdk_rep_runtime_test PRIVATE "${PGR1_SDK_SOURCE_DIR}/runtime")
  target_compile_options(pgr1_sdk_rep_runtime_test PRIVATE -Wall -Wextra -Wpedantic -UNDEBUG)
  add_test(NAME sdk_rep_runtime_semantics COMMAND pgr1_sdk_rep_runtime_test)
  if(EXISTS "${PGR1_SDK_SOURCE_DIR}/runtime/kernel/physical_write_audit.h")
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
      add_executable(pgr1_sdk_memory_lifecycle_test "${PGR1_ROOT}/portable/tests/memory/test_sdk_memory_lifecycle.cpp"
        "${PGR1_SDK_SOURCE_DIR}/runtime/kernel/memory.cpp" "${PGR1_SDK_SOURCE_DIR}/runtime/core/log.cpp")
      target_include_directories(pgr1_sdk_memory_lifecycle_test PRIVATE "${PGR1_SDK_SOURCE_DIR}/runtime")
      target_compile_definitions(pgr1_sdk_memory_lifecycle_test PRIVATE XBE_PHYSICAL_WRITE_AUDIT=1)
      target_compile_options(pgr1_sdk_memory_lifecycle_test PRIVATE -Wall -Wextra -Wpedantic -UNDEBUG)
      add_test(NAME sdk_memory_lifecycle_journal COMMAND pgr1_sdk_memory_lifecycle_test)
    endif()
    add_executable(pgr1_sdk_rep_audit_test "${PGR1_ROOT}/portable/tests/memory/test_sdk_rep_runtime.cpp")
    target_include_directories(pgr1_sdk_rep_audit_test PRIVATE "${PGR1_SDK_SOURCE_DIR}/runtime")
    target_compile_definitions(pgr1_sdk_rep_audit_test PRIVATE XBE_PHYSICAL_WRITE_AUDIT=1)
    target_compile_options(pgr1_sdk_rep_audit_test PRIVATE -Wall -Wextra -Wpedantic -UNDEBUG)
    add_test(NAME sdk_rep_audit_semantics COMMAND pgr1_sdk_rep_audit_test)
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
      set(PGR1_ZYDIS_TEST_SOURCE "${PGR1_ROOT}/build/linux/_deps/zydis-src" CACHE PATH "Local Zydis 4.1.1 sources for actual generated-store tests")
      if(EXISTS "${PGR1_ZYDIS_TEST_SOURCE}/CMakeLists.txt")
        if(NOT TARGET Zydis)
          set(ZYDIS_BUILD_TOOLS OFF CACHE BOOL "" FORCE)
          set(ZYDIS_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
          set(ZYDIS_BUILD_DOXYGEN OFF CACHE BOOL "" FORCE)
          add_subdirectory("${PGR1_ZYDIS_TEST_SOURCE}" "${CMAKE_BINARY_DIR}/sdk-test-zydis" EXCLUDE_FROM_ALL)
        endif()
        file(GLOB PGR1_SDK_CODEGEN_TEST_SOURCES CONFIGURE_DEPENDS "${PGR1_SDK_SOURCE_DIR}/tools/recomp/codegen*.cpp")
        add_executable(pgr1_sdk_store_fixture_generator
          "${PGR1_ROOT}/portable/tests/memory/generate_sdk_store_fixture.cpp"
          "${PGR1_SDK_SOURCE_DIR}/tools/recomp/analysis.cpp" ${PGR1_SDK_CODEGEN_TEST_SOURCES})
        target_include_directories(pgr1_sdk_store_fixture_generator PRIVATE "${PGR1_SDK_SOURCE_DIR}/tools/recomp" "${PGR1_SDK_SOURCE_DIR}/runtime")
        target_link_libraries(pgr1_sdk_store_fixture_generator PRIVATE Zydis)
        target_compile_options(pgr1_sdk_store_fixture_generator PRIVATE -UNDEBUG)
        set(PGR1_SDK_STORE_FIXTURE_DIR "${CMAKE_BINARY_DIR}/sdk-store-fixture")
        add_custom_command(OUTPUT "${PGR1_SDK_STORE_FIXTURE_DIR}/x86_recomp.0.cpp" "${PGR1_SDK_STORE_FIXTURE_DIR}/x86_func_mapping.cpp"
          COMMAND pgr1_sdk_store_fixture_generator "${PGR1_SDK_STORE_FIXTURE_DIR}"
          DEPENDS pgr1_sdk_store_fixture_generator "${PGR1_ROOT}/portable/tests/memory/sdk_store_cases.h" VERBATIM)
        add_executable(pgr1_sdk_generated_stores_test "${PGR1_ROOT}/portable/tests/memory/test_sdk_generated_stores.cpp"
          "${PGR1_SDK_STORE_FIXTURE_DIR}/x86_recomp.0.cpp" "${PGR1_SDK_STORE_FIXTURE_DIR}/x86_func_mapping.cpp")
        target_include_directories(pgr1_sdk_generated_stores_test PRIVATE "${PGR1_SDK_SOURCE_DIR}/runtime")
        target_compile_definitions(pgr1_sdk_generated_stores_test PRIVATE XBE_PHYSICAL_WRITE_AUDIT=1)
        target_compile_options(pgr1_sdk_generated_stores_test PRIVATE -UNDEBUG)
        add_test(NAME sdk_actual_generated_stores COMMAND pgr1_sdk_generated_stores_test)
      else()
        message(STATUS "Actual SDK generated-store test unavailable: set PGR1_ZYDIS_TEST_SOURCE to local Zydis sources")
      endif()
    endif()
  endif()
endif()
